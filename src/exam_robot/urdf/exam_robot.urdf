<?xml version="1.0"?>
<robot name="exam_robot">

    <!-- ============================================ -->
    <!-- BASE LINK — корпус робота -->
    <!-- ============================================ -->
    <link name="base_link">
        <!-- Как выглядит (визуализация) -->
        <visual>
            <geometry>
                <!-- Коробка: длина x ширина x высота (метры) -->
                <box size="0.4 0.3 0.1"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 0.8 1"/>
            </material>
        </visual>

        <!-- Форма для столкновений (физика) -->
        <collision>
            <geometry>
                <box size="0.4 0.3 0.1"/>
            </geometry>
        </collision>

        <!-- Физические свойства -->
        <inertial>
            <mass value="5.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0"
                     iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>

    <!-- ============================================ -->
    <!-- SENSOR — датчик расстояния -->
    <!-- ============================================ -->
    <link name="sensor_link">
        <visual>
            <geometry>
                <box size="0.05 0.05 0.05"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.05 0.05 0.05"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                     iyy="0.0001" iyz="0.0" izz="0.0001"/>
        </inertial>
    </link>

    <!-- Сустав: base_link → sensor_link -->
    <joint name="base_to_sensor" type="fixed">
        <parent link="base_link"/>
        <child link="sensor_link"/>
        <!-- Позиция: 20 см вперёд, 7.5 см вверх -->
        <origin xyz="0.2 0 0.08" rpy="0 0 0"/>
    </joint>

    <!-- ============================================ -->
    <!-- LEFT WHEEL — левое колесо (ИСПРАВЛЕНО) -->
    <!-- ============================================ -->
    <link name="wheel_left_link">
        <visual>
            <geometry>
                <cylinder length="0.04" radius="0.08"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.04" radius="0.08"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <!-- Правильные моменты инерции для цилиндра -->
            <inertia ixx="0.0003" ixy="0.0" ixz="0.0"
                     iyy="0.0005" iyz="0.0" izz="0.0003"/>
        </inertial>
    </link>

    <!-- Сустав: base_link → left_wheel (ИСПРАВЛЕН) -->
    <joint name="base_to_left_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_left_link"/>
        <!-- Позиция: слева от корпуса (по Y), 
             Поворот: -90° вокруг X, чтобы цилиндр лежал горизонтально -->
        <origin xyz="0 0.17 0" rpy="-1.5708 0 0"/>
        <!-- Ось вращения: вокруг Y (чтобы колесо крутилось вперёд-назад) -->
        <axis xyz="0 1 0"/>
    </joint>

    <!-- ============================================ -->
    <!-- RIGHT WHEEL — правое колесо (ИСПРАВЛЕНО) -->
    <!-- ============================================ -->
    <link name="wheel_right_link">
        <visual>
            <geometry>
                <cylinder length="0.04" radius="0.08"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.04" radius="0.08"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <!-- Правильные моменты инерции для цилиндра -->
            <inertia ixx="0.0003" ixy="0.0" ixz="0.0"
                     iyy="0.0005" iyz="0.0" izz="0.0003"/>
        </inertial>
    </link>

    <!-- Сустав: base_link → right_wheel (ИСПРАВЛЕН) -->
    <joint name="base_to_right_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_right_link"/>
        <!-- Позиция: справа от корпуса (отрицательный Y) -->
        <origin xyz="0 -0.17 0" rpy="-1.5708 0 0"/>
        <!-- Ось вращения: вокруг Y (симметрично левому колесу) -->
        <axis xyz="0 1 0"/>
    </joint>

</robot>